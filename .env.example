# Copy this file to .env and fill in your own Supabase project values.
# Never commit the real .env file — it's already in .gitignore.
# Only the anon (public) key belongs here. Never put a service-role key
# in frontend code or in any file that ships to the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# LiveKit connection URL (public — safe in frontend code, it's just a
# websocket address, not a credential).
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# LIVEKIT_API_KEY and LIVEKIT_API_SECRET are NOT set here.
# They are server-side-only secrets used by netlify/functions/create-livekit-token.mts
# and must be set in Netlify's dashboard (Site settings → Environment
# variables), never in this file and never with a VITE_ prefix.
